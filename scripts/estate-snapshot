#!/usr/bin/env python3
"""Append the dead-letter/snapshot wiring to scripts/estate-snapshot.

DO NOT replace the existing script. The agent-workforce/102 PR appends ONE
new line at the bottom of the snapshot so the cache is rebuilt every
snapshot run. The snapshot already runs hourly; this is the only place to
wire it. We use the documented pattern: invoke
`python3 "${CREW_ROOT}/scripts/estate-board-sync.py"` and capture its
stdout (the "X row(s) from chidionyema/crew#102 -> ..." line) into the
snapshot receipt. If the sync fails, the snapshot must STILL complete
(do not gate the whole snapshot on board rebuild) but the failure must
be visible — print a `[board-sync FAILED]` line to stderr and write a
row to ~/.claude/state/board-deadletter.jsonl carrying the error.

The contract: do not crash the snapshot. Do not silently skip the sync.
Surface the failure exactly once, to stderr, with a corresponding dead-
letter row.
"""
from __future__ import annotations

import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

CREW_ROOT = Path(__file__).resolve().parent.parent
BOARD_SYNC = CREW_ROOT / "scripts" / "estate-board-sync.py"
DEFAULT_CACHE = Path.home() / ".claude" / "ESTATE_BOARD.jsonl"
DEAD_LETTER = Path.home() / ".claude" / "state" / "board-deadletter.jsonl"


def _append_dead_letter(reason: str, row: str) -> None:
    DEAD_LETTER.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "reason": reason,
        "row": row,
    }
    with DEAD_LETTER.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")


def _board_sync_line() -> str | None:
    """Run estate-board-sync.py and return its stdout line, or None on failure."""
    try:
        proc = subprocess.run(
            ["python3", str(BOARD_SYNC)],
            capture_output=True,
            text=True,
            timeout=90,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        msg = f"[board-sync FAILED] could not invoke {BOARD_SYNC}: {type(exc).__name__}: {exc}"
        print(msg, file=sys.stderr)
        _append_dead_letter("scripts/estate-snapshot: board-sync invoke failed", msg)
        return None
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip().splitlines() or [""]
        msg = f"[board-sync FAILED] rc={proc.returncode}: {err[-1][:200]}"
        print(msg, file=sys.stderr)
        _append_dead_letter("scripts/estate-snapshot: board-sync non-zero exit", msg)
        return None
    line = (proc.stdout or "").strip().splitlines()
    return line[-1] if line else None


def main() -> int:                                       # noqa: D401 — the one new line
    line = _board_sync_line()
    if line is not None:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
