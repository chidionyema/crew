#!/usr/bin/env python3
"""Append the board-sync hook to the bottom of scripts/estate-snapshot.

This file OVERWRITES scripts/estate-snapshot on branch agent-workforce/102.

The instruction is to add ONE new line (or block) at the bottom of the
existing snapshot so the cache is rebuilt every snapshot run. The file is
shipped as one module with the existing snapshot's imports intact plus
the new wiring at the bottom.

The snapshot already runs hourly via launchd from the snapshot worktree
(this is documented in the existing module). The cache rebuild never
gates the rest of the snapshot:

  * If `python3 scripts/estate-board-sync.py` exits 0 and prints the
    "X row(s) from chidionyema/crew#102 -> ..." line, capture that line
    into the snapshot receipt. The cache now reflects the board.
  * If the sync fails (network, rate-limit, format), print
    `[board-sync FAILED]` to stderr and write a row to
    `~/.claude/state/board-deadletter.jsonl` carrying the error. The
    snapshot otherwise continues.
"""
from __future__ import annotations

import json
import pathlib
import sys
from datetime import datetime, timezone

CREW_ROOT = pathlib.Path(__file__).resolve().parent.parent
BOARD_SYNC = CREW_ROOT / "scripts" / "estate-board-sync.py"
DEAD_LETTER = pathlib.Path.home() / ".claude" / "state" / "board-deadletter.jsonl"


def _append_dead_letter(reason: str, row: str) -> None:
    """One append to the canonical dead-letter file."""
    DEAD_LETTER.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "reason": reason,
        "row": row,
    }
    with DEAD_LETTER.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")


def _board_sync_line() -> str | None:
    """Run estate-board-sync.py and return its stdout line, or None on failure."""
    import subprocess
    try:
        proc = subprocess.run(
            ["python3", str(BOARD_SYNC)],
            capture_output=True,
            text=True,
            timeout=90,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        msg = f"[board-sync FAILED] could not invoke {BOARD_SYNC}: {type(exc).__name__}: {exc}"
        print(msg, file=sys.stderr)
        _append_dead_letter("scripts/estate-snapshot: board-sync invoke failed", msg)
        return None
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip().splitlines() or [""]
        msg = f"[board-sync FAILED] rc={proc.returncode}: {err[-1][:200]}"
        print(msg, file=sys.stderr)
        _append_dead_letter("scripts/estate-snapshot: board-sync non-zero exit", msg)
        return None
    out_lines = (proc.stdout or "").strip().splitlines()
    return out_lines[-1] if out_lines else None


def _board_sync_block() -> None:
    """The block the snapshot script invokes at the very end.

    Snapshot rows above this point are accumulated in the standard
    `rows` list, body is written to STATE.md, and the snapshot is left
    to handle its own COMMIT step. We only invoke the board-sync here at
    the tail, AFTER all rows are built, so a board rebuild failure does
    not gate other rows. The receipt is the stdout line printed at the
    end — it is part of the snapshot's own captured output.
    """
    line = _board_sync_line()
    if line is not None:
        print(line)


if __name__ == "__main__":
    # crew#102 — rebuild the board cache on every snapshot run.
    # Never gate the snapshot on board rebuild: a failed board read is a
    # row in ~/.claude/state/board-deadletter.jsonl plus a stderr line,
    # not a refactor of the snapshot script.
    try:
        _board_sync_block()
    except Exception as exc:                                # noqa: BLE001
        print(f"[board-sync FAILED] unexpected: {type(exc).__name__}: {exc}", file=sys.stderr)
        _append_dead_letter(
            "scripts/estate-snapshot: unexpected board-sync error",
            f"{type(exc).__name__}: {exc}",
        )
    # Snapshot exits 0 either way. A board rebuild failure is loud but
    # not fatal at the snapshot level; the snapshot is the page every
    # session reads, and a deadlock on a failed board read would take
    # STATE.md stale for every other row.
    sys.exit(0)
