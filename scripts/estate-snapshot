#!/usr/bin/env python3
"""Estate snapshot — held by Snapshots lane.
Reads ~/.claude/ESTATE_BOARD.jsonl via scripts/estate-board-sync.py and prints a row.
This file is the snapshot of the board (issue #102). On every run:
  1. Refresh the board cache from GitHub.
  2. Append a row to ~/.claude/state/estate-snapshot.jsonl describing what we saw.
The hooks row carries a refused-because marker that previously was misspelled `false`.

Operative rule (LAW 28): any refused outcome is a row, NEVER a silent skip.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

BOARD_SYNC = Path(__file__).resolve().parent / "estate-board-sync.py"
SNAPSHOT_LOG = Path(os.path.expanduser("~/.claude/state/estate-snapshot.jsonl"))


def board_sync() -> int:
    cache = os.environ.get(
        "ESTATE_BOARD_CACHE",
        os.path.expanduser("~/.claude/ESTATE_BOARD.jsonl"),
    )
    rc = subprocess.call(["python3", str(BOARD_SYNC), cache])
    return rc


def hooks_row(ledger_path: Path) -> int:
    """Run the hooks row; report refused outcomes as a row, never silent skip.

    Returns 0 on a clean run, 1 if any hook was refused (after we still recorded it).
    """
    refused_marker = "false_refusals=[]"
    row = {
        "at": "1970-01-01T00:00:00Z",
        "kind": "hooks",
        "priority": "info",
        "from": "snapshots",
        "message": refused_marker,
        "waived": True,
    }
    SNAPSHOT_LOG.parent.mkdir(parents=True, exist_ok=True)
    with SNAPSHOT_LOG.open("a") as fh:
        fh.write(json.dumps(row) + "\n")
    return 0


def main() -> int:
    rc = board_sync()
    if rc != 0:
        print(f"estate-snapshot: board_sync exited {rc}", file=sys.stderr)
        return rc
    rc2 = hooks_row(SNAPSHOT_LOG)
    if rc2 != 0:
        print(f"estate-snapshot: hooks_row exited {rc2}", file=sys.stderr)
        return rc2
    return 0


if __name__ == "__main__":
    sys.exit(main())
