#!/usr/bin/env python3
"""Write the one snapshot every agent and the founder read instead of rediscovering state.

Six sessions cannot see each other. Before this existed each one re-measured the estate
from scratch, and the founder was asked the same questions he had already answered. The
board (crew issues) records decisions; nothing recorded the live state.

Every row here is a command and its output. Nothing is prose about a state, because prose
about a state is how a roadmap came to read "live" while the process ran 32-hour-old code.
A row that could not be measured says NOT RUN, never PASS, because a dead checker and a
healthy estate must never look the same (LAW 31).

    scripts/estate-snapshot            write STATE.md, print it, exit 0
    scripts/estate-snapshot --commit   write, commit and push it to main

`--commit` refuses, loudly and non-zero, unless this checkout is on main with no merge in
progress. It ran hourly from the shared checkout for months without asking where it was,
and on 2026-08-24 it wrote the estate's state onto a feature branch somebody had left
checked out. Everything looked green: it committed, exited 0, and printed "committed:".
STATE.md on main went two and a half hours stale while every session read it and could not
tell. See tests/test_incident_snapshot_committed_to_a_stranded_branch.py.
"""
from __future__ import annotations

import datetime as dt
import json
import pathlib
import re
import subprocess
import sys
import time

#: bin/verify colours its rows. Colour codes in a markdown table render as literal
#: escape bytes on GitHub, which makes the snapshot look broken to the one reader
#: it exists for.
ANSI = re.compile(r"\x1b\[[0-9;]*m")

ROOT = pathlib.Path(__file__).resolve().parent.parent
HOME = pathlib.Path.home()


def sh(cmd: str, timeout: int = 30) -> tuple[int, str]:
    try:
        #: check=False: this function returns the return code to its caller. Every row
        #: on the board is "what did that command say", non-zero included.
        p = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                           timeout=timeout, errors="replace", check=False)
        return p.returncode, ANSI.sub("", p.stdout + p.stderr).strip()
    except subprocess.TimeoutExpired:
        return 124, f"TIMED OUT after {timeout}s"
    except Exception as exc:                                    # noqa: BLE001
        return 1, f"{type(exc).__name__}: {exc}"


def age_hours(path: pathlib.Path) -> float | None:
    try:
        import time
        return (time.time() - path.stat().st_mtime) / 3600
    except OSError:
        return None


def architect() -> list[str]:
    d = HOME / "dev/code/hermes-v2"
    if not d.exists():
        return [f"| The Architect | NOT RUN | `{d}` does not exist |"]
    _rc, out = sh(f"cd {d} && ./bin/verify 2>&1", timeout=120)
    line = next((ln.strip() for ln in out.splitlines() if "passed" in ln), "")
    fails = [ln.strip() for ln in out.splitlines() if "FAIL" in ln]
    if not line:
        return ["| The Architect | NOT RUN | bin/verify produced no verdict line |"]
    state = "GREEN" if "0 failed" in line or "failed" not in line else "RED"
    rows = [f"| The Architect | {state} | `bin/verify`: {line} |"]
    for f in fails:
        rows.append(f"| &nbsp;&nbsp;failing | | {f} |")
    return rows


def maestro() -> list[str]:
    intents = sorted((HOME / ".maestro/intents").glob("INTENT-*.json"),
                     key=lambda p: p.stat().st_mtime, reverse=True) \
        if (HOME / ".maestro/intents").exists() else []
    if not intents:
        return ["| maestro | NOT RUN | no INTENT files, so nothing has sensed |"]
    a = age_hours(intents[0]) or 99
    state = "GREEN" if a < 0.25 else ("STALE" if a < 2 else "RED")
    rows = [f"| maestro | {state} | last cycle {a * 60:.0f} min ago (`{intents[0].name}`) |"]
    _rc, out = sh(f"sqlite3 {HOME / '.maestro/experience_graph.db'} 'select count(*) from skills;'")
    rows.append("| &nbsp;&nbsp;skills | {} | {} skill(s) it can heal with |".format("GREEN" if out.isdigit() and int(out) else "RED", out or "NOT RUN"))
    return rows


def fly() -> list[str]:
    rc, out = sh("flyctl apps list 2>&1", timeout=45)
    if rc or "NAME" not in out:
        return [f"| Fly | NOT RUN | `flyctl apps list` failed: {out.splitlines()[0][:80]} |"]
    dep = sum(1 for ln in out.splitlines() if "deployed" in ln)
    sus = sum(1 for ln in out.splitlines() if "suspended" in ln)
    rows = [f"| Fly | {dep} deployed, {sus} suspended | `flyctl apps list` |"]

    # Names and dates, not just a count. A count is a pointer to the data and
    # sessions fill the rest in from memory: on 2026-08-24 three of them were
    # passing round "tie suspended since 18 Aug" when tie-api's last release was
    # 13 June, and 18 Aug belonged to prospector-searxng. Naming each dead app
    # and the day it last shipped is what stops that (crew#118).
    dead = []
    for line in out.splitlines():
        cells = [c.strip() for c in line.split("│")]
        if len(cells) < 4 or "suspended" not in cells[2]:
            continue
        name, when = cells[0], cells[3]
        if when:                       # no date means it never shipped at all
            dead.append((name, when))
    for name, when in sorted(dead, key=lambda p: p[0]):
        rows.append(f"| &nbsp;&nbsp;{name} | suspended, last release {when} | R1: it does not come "
                    "back on Fly |")
    return rows


def github_actions() -> list[str]:
    """The provider's own word on whether CI can run at all (crew#284, 2026-08-26).

    Three PRs sat 25 minutes on `pending` and one session read that as slow runners.
    githubstatus.com said Actions=major_outage the whole time, and every cancelled job
    carried 'The job was not acquired by Runner of type hosted'. A RED row here is read
    before any PR is, so nobody attributes a provider outage to their own branch again.
    """
    rc, out = sh("curl -s -m 10 https://www.githubstatus.com/api/v2/components.json", timeout=20)
    if rc or not out:
        return ["| GitHub Actions | NOT RUN | githubstatus.com unreachable |"]
    try:
        comps = {c["name"]: c["status"] for c in json.loads(out)["components"]}
    except (ValueError, KeyError, TypeError) as exc:
        return [f"| GitHub Actions | NOT RUN | {type(exc).__name__} parsing githubstatus.com |"]
    st = comps.get("Actions")
    if st is None:
        return ["| GitHub Actions | NOT RUN | githubstatus.com lists no Actions component |"]
    colour = "GREEN" if st == "operational" else "RED"
    return [f"| GitHub Actions | {colour} {st} | githubstatus.com; a red row means pending CI is theirs, not yours |"]


def crew_p1() -> list[str]:
    rc, out = sh("gh issue list --repo chidionyema/crew --state open --label P1 "
                 "--json number,title -q '.[] | \"#\\(.number) \\(.title)\"'", timeout=45)
    if rc:
        return ["| crew P1 | NOT RUN | `gh issue list` failed |"]
    items = [ln for ln in out.splitlines() if ln.strip()]
    if not items:
        return ["| crew P1 | GREEN | no open P1 issues |"]
    rows = [f"| crew P1 | {len(items)} open | the fires nobody has put out |"]
    for i in items:
        rows.append("| &nbsp;&nbsp;{} | | |".format(i.replace("|", "/")[:110]))
    return rows


def spend() -> list[str]:
    """The money row, read from the science warehouse.

    This is the reader `science/collect.py` was built for. The number reaches the
    founder here and nowhere else, because a spend series he has to query is a
    spend series he will not look at (LAW 31).
    """
    db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
    if not db.exists():
        return ["| estate spend | NOT RUN | no warehouse: run `science/collect.py` |"]
    rc, out = sh(f"sqlite3 {db} \"select round(avg(usd),0) from "
                 "(select usd from spend_daily order by day desc limit 7);\"", timeout=20)
    if rc or not out.strip():
        return ["| estate spend | NOT RUN | `spend_daily` view did not answer |"]
    try:
        rate = float(out.strip())
    except ValueError:
        return [f"| estate spend | NOT RUN | `spend_daily` returned {out.strip()[:40]!r} |"]
    cap = 120.0
    state = "GREEN" if rate <= cap else "RED"
    return [f"| estate spend | {state} | ${rate:.0f}/day 7-day mean against a ${cap:.0f} cap "
            f"(`spend_daily`, {db.name}) |"]


def revenue() -> list[str]:
    """The other side of every efficiency number (crew#70).

    Read from `science/revenue.jsonl`, the series `outcomes.py revenue` appends to. GREEN
    only when the store answered inside the staleness bar; a row the store did not answer
    is NOT RUN, never a zero, because an unmeasured zero and a measured zero look the same
    on a page and only one of them is true.
    """
    path = pathlib.Path(__file__).resolve().parent.parent / "science" / "revenue.jsonl"
    return revenue_row(path)


def revenue_row(path: pathlib.Path, now: float | None = None, stale_hours: int = 24) -> list[str]:
    if not path.exists():
        return ["| revenue | NOT RUN | no `science/revenue.jsonl`: run `science/outcomes.py revenue` |"]
    last = None
    for line in path.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                last = json.loads(line)
            except json.JSONDecodeError:
                continue
    if not last:
        return ["| revenue | NOT RUN | `science/revenue.jsonl` holds no row |"]
    at = last.get("at", "")
    try:
        ts = dt.datetime.strptime(at, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc).timestamp()
    except ValueError:
        return [f"| revenue | NOT RUN | last row has no readable `at` ({at[:25]!r}) |"]
    age_h = ((now if now is not None else time.time()) - ts) / 3600
    if age_h > stale_hours:
        return [f"| revenue | NOT RUN | last measurement {at} is {age_h:.0f}h old (bar {stale_hours}h) |"]
    if not last.get("measured"):
        return [f"| revenue | NOT RUN | store not measured at {at}: {str(last.get('reason', ''))[:90]} |"]
    n = int(last.get("paid_orders", 0))
    cur = last.get("currency") or ""
    if n == 0:
        return [f"| revenue | GREEN | 0 paid orders, measured {at} from the store (`outcomes.py revenue`) |"]
    return [f"| revenue | GREEN | {n} paid order(s), {last.get('total')} {cur}, {len(last.get('payers', []))} payer(s), "
            f"first {last.get('first_paid_at')} last {last.get('last_paid_at')}, measured {at} |"]


def _broadcast_strands(per_repo: list[tuple[int, float, int, str]], now: float) -> None:
    """Tell the lane that owns a strand, once a day, on the channel it already reads.

    A RED row on a page is pull, and the session that stranded the work never pulls.
    The estate board is injected into every session at prompt time, so a row here
    reaches the owning lane without anyone polling (crew #97 phase 2a). One row per
    repo per day; the dedup key is the repo name before the colon.
    """
    board = HOME / ".claude/ESTATE_BOARD.jsonl"
    caster = HOME / ".claude/scripts/estate-broadcast.py"
    if not caster.exists():
        return
    try:
        seen = set()
        cutoff = now - 24 * 3600
        lines = board.read_text().splitlines()[-500:] if board.exists() else []
        for line in lines:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("from") != "estate-delivery" or row.get("kind") != "stranded":
                continue
            try:
                ts = dt.datetime.fromisoformat(
                    str(row.get("ts") or row.get("timestamp")).replace("Z", "+00:00"))
            except ValueError:
                continue
            if ts.timestamp() >= cutoff:
                seen.add(str(row.get("message", "")).split(":", 1)[0])
        for n, oldest, _dirty, name in per_repo:
            if n and oldest > 1.0 and name not in seen:
                sh(f"python3 '{caster}' --from estate-delivery --kind stranded --message "
                   f"'{name}: {n} commits on no remote, oldest {oldest:.1f}d. Push the branch or say "
                   "on crew #97 why it must stay local.'",
                   timeout=20)
    except OSError:
        pass


def delivery() -> list[str]:
    """What the fleet shipped against what it stranded.

    First run, 2026-08-24 (crew #97): 32 commits sat on branches no remote holds,
    the oldest 7.7 days old — and the estate board's last 24 hours held 130
    guard-broken rows and not one row saying anything shipped. The spend row above is rebuilt hourly; nothing measured
    what the spend bought. A pipeline nobody measures is how "cost drain not
    delivering" stayed a feeling instead of a number (LAW 28).

    Stranded means commits reachable from a local branch and from no remote ref —
    work that dies with this laptop. Dormant repos (no commit anywhere in 30 days)
    are dead weight, not stranded work, and are excluded.
    """
    candidates = [*sorted(HOME.glob("dev/code/*")),
                  HOME / ".claude/scripts", HOME / ".claude",
                  HOME / "Documents/code/prospector"]
    now = dt.datetime.now(dt.timezone.utc).timestamp()
    seen: set[str] = set()
    per_repo: list[tuple[int, float, int, str]] = []
    for d in candidates:
        if not (d / ".git").exists():
            continue
        rc, url = sh(f"git -C '{d}' remote get-url origin", timeout=10)
        key = url if not rc and url else str(d)
        if key in seen:            # prospector has two checkouts of one repo
            continue
        seen.add(key)
        rc, last = sh(f"git -C '{d}' log -1 --format=%ct --all", timeout=10)
        if rc or not last.isdigit() or now - int(last) > 30 * 86400:
            continue
        rc, out = sh(f"git -C '{d}' log --branches --not --remotes --format=%ct",
                     timeout=20)
        cts = [int(t) for t in out.split() if t.isdigit()]
        rc, st = sh(f"git -C '{d}' status --porcelain", timeout=20)
        dirty = len([ln for ln in st.splitlines() if ln.strip()])
        if cts or dirty:
            oldest = (now - min(cts)) / 86400 if cts else 0.0
            per_repo.append((len(cts), oldest, dirty, d.name))

    _broadcast_strands(per_repo, now)

    stranded = sum(r[0] for r in per_repo)
    oldest = max((r[1] for r in per_repo), default=0.0)
    dirty = sum(r[2] for r in per_repo)

    since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=7)).strftime("%Y-%m-%d")
    # Bot bumps are not the fleet delivering; a capped count is a floor, not a count.
    cap = 1000
    rc, out = sh(f"gh search prs --owner chidionyema --merged --merged-at '>={since}' "
                 f"-L {cap} --json number --jq length -- -author:app/dependabot",
                 timeout=45)
    merged = int(out) if not rc and out.isdigit() else None

    state = "GREEN" if stranded == 0 else ("STALE" if oldest < 1 else "RED")
    rows = [f"| delivery | {state} | {stranded} commits on no remote (oldest {oldest:.1f}d), "
            f"{dirty} dirty files, {len(per_repo)} live repos "
            "(`git log --branches --not --remotes`) |"]
    if merged is None:
        rows.append("| &nbsp;&nbsp;shipped | NOT RUN | `gh search prs --merged` "
                    "did not answer |")
    else:
        cost = ""
        db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
        rc, rate = sh(f"sqlite3 {db} \"select round(avg(usd),0) from (select usd from "
                      "spend_daily order by day desc limit 7);\"", timeout=20)
        try:
            if not rc and merged:
                cost = ", ~$%.0f of estate spend per shipped change" % (
                    7 * float(rate) / merged)
        except ValueError:
            pass
        shown = str(merged) if merged < cap else f">={merged}"
        if merged >= cap:
            cost = ""
        rows.append(f"| &nbsp;&nbsp;shipped | {shown} merged | non-bot PRs merged across the "
                    f"estate in 7d{cost} (`gh search prs`) |")
    for n, old, dr, name in sorted(per_repo, reverse=True)[:3]:
        if n:
            rows.append(f"| &nbsp;&nbsp;stranded | {name} | {n} commits no remote holds, "
                        f"oldest {old:.1f}d, {dr} dirty |")
    return rows


def founder() -> list[str]:
    """What the estate cost HIM this week, against last week.

    Every other row on this page measures the estate. This one measures the person it is
    for. LAW 36 says the complaint is the measurement and not a mood, and until 2026-08-24
    nothing kept a series of them: `friction-relay.py` holds six hours and is rebuilt at
    every session start, so "is this getting better or worse" had no answer.

    Two numbers, both his: how many messages the estate needed from him, and what share of
    them were complaints. Falling messages with a flat complaint rate is the estate needing
    him less. A rising complaint rate is the platform telling on itself.
    """
    db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
    if not db.exists():
        return [f"| founder cost | NOT RUN | no warehouse at {db.name} |"]
    rc, out = sh(f"sqlite3 -separator '\t' {db} \"select day, messages, complaints "
                 "from attention_daily order by day desc limit 14;\"", timeout=20)
    if rc or not out.strip():
        return ["| founder cost | NOT RUN | `attention_daily` did not answer |"]
    days = []
    for line in out.strip().split("\n"):
        p = line.split("\t")
        if len(p) == 3:
            try:
                days.append((p[0], int(p[1]), int(p[2])))
            except ValueError:
                continue
    if len(days) < 4:
        return [f"| founder cost | NOT RUN | only {len(days)} days collected, needs 4 |"]

    this, prev = days[:7], days[7:14]
    def rate(rows):
        m = sum(r[1] for r in rows) or 1
        return sum(r[2] for r in rows), m, 100.0 * sum(r[2] for r in rows) / m
    c1, m1, r1 = rate(this)
    if not prev:
        return [f"| founder cost | {m1} msgs | {c1} complaints, {r1:.0f}%, last {len(this)} days "
                "(`attention_daily`) |"]
    _c0, m0, r0 = rate(prev)
    # A complaint rate that rose is the platform getting worse for the one person it is
    # for, whatever the other rows on this page say.
    state = "GREEN" if r1 <= r0 else "RED"
    return [f"| founder cost | {state} | {m1} msgs / {r1:.0f}% complaints this week against "
            f"{m0} / {r0:.0f}% last (`attention_daily`) |"]


def collectors() -> list[str]:
    """Which of the estate's data stores have stopped being written.

    Two were already dead when the warehouse was built — `would-have-fired.jsonl`
    had been silent 49 hours and `DECISIONS.jsonl` 54, and nothing anywhere said
    so. `collect.py --check` finds them and exits 1, but it exits 1 into a log
    file, and a log file is not a reader (LAW 28). This is the reader.

    It reports NOT RUN, never GREEN, when the collector itself has stopped, because
    a board that cannot tell "everything is fine" from "nobody checked" is worse
    than no board.
    """
    db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
    if not db.exists():
        return [f"| collectors | NOT RUN | no warehouse at {db.name} |"]
    rc, out = sh(f"sqlite3 -separator '\t' {db} \"select source, source_mtime, status, "
                 "max(ingested_at) from ingest_log group by source;\"", timeout=20)
    if rc or not out.strip():
        return ["| collectors | NOT RUN | `ingest_log` did not answer |"]

    now = dt.datetime.now(dt.timezone.utc)
    dead, newest_ingest = [], None
    for line in out.strip().split("\n"):
        parts = line.split("\t")
        if len(parts) < 4:
            continue
        source, mtime, status, ingested = parts[0], parts[1], parts[2], parts[3]
        try:
            ing = dt.datetime.fromisoformat(ingested)
            newest_ingest = max(newest_ingest, ing) if newest_ingest else ing
        except ValueError:
            pass
        if status != "OK":
            dead.append(f"{source} {status}")
            continue
        try:
            age_h = (now - dt.datetime.fromisoformat(mtime)).total_seconds() / 3600
        except ValueError:
            continue
        # 48h is collect.py's own default. Anything quieter than two full days is a
        # collector that stopped, not a quiet period.
        if age_h > 48:
            dead.append(f"{source} silent {age_h:.0f}h")

    # The collector runs hourly. If its own last run is older than three of those,
    # the rows above are stale and this row must not claim to have checked anything.
    if newest_ingest is None:
        return ["| collectors | NOT RUN | `ingest_log` holds no timestamp |"]
    since_h = (now - newest_ingest).total_seconds() / 3600
    if since_h > 3:
        return [f"| collectors | NOT RUN | warehouse last rebuilt {since_h:.0f}h ago; "
                "`com.founder.sciencecollect` is not running |"]

    if dead:
        dead_names = "; ".join(dead[:4])
        return [f"| collectors | RED | {len(dead)} of the estate's data stores stopped being "
                f"written: {dead_names} |"]
    return ["| collectors | GREEN | every data store written inside 48h "
            f"(`ingest_log`, checked {since_h:.0f}h ago) |"]



def datamap() -> list[str]:
    """LAW 50: every producer of data carries a verdict, every gap a ticket. The gate runs
    here because this is the one scheduled job that can see the Mac, git and `gh` at once;
    a row that says NOT RUN is the gate being blind, never the gate being green."""
    _rc, out = sh(f"python3 {ROOT / 'science' / 'datamap.py'} --check --json", timeout=240)
    try:
        doc = json.loads(out[out.index("{"):])
    except (ValueError, json.JSONDecodeError):
        return ["| data map | NOT RUN | `science/datamap.py --check --json` did not answer |"]
    prods = doc.get("producers", [])
    n = len(prods)
    unexplained = sum(1 for g in prods if g.get("verdict") == "UNEXPLAINED")
    gaps = sum(1 for g in prods if g.get("verdict") in ("WIRED_NEVER", "WRITER_DEAD", "NEVER_EMITTED"))
    measurables = sum(len(g.get("measures", [])) for g in prods)
    blind = doc.get("blind", {})
    bad = doc.get("violations", [])
    grade = "GREEN" if not bad else "RED"
    detail = (f"{n} producers, {measurables} measurables, {gaps} in gaps with a ticket, "
              f"{unexplained} unexplained, blind: {', '.join(blind) or 'none'}")
    rows = [f"| data map | {grade} | {detail} (`science/datamap.py --check`) |"]
    for b in bad[:3]:
        rows.append(f"| &nbsp;&nbsp;violation | | {b[:110]} |")
    return rows



def runtime() -> list[str]:
    """The platform is OKE on Oracle; the laptop runs no VM. Both are measured, never asserted.

    Incident 2026-08-25: a session answered "Oracle: nothing provisioned" from a doc while
    the OKE cluster had been serving prospector for 13 hours, because this file had no
    Oracle row and the colima rows below it rewarded a VM the founder had just banned
    (R26). The laptop VM row runs the R26 guard; the OKE rows run kubectl against the
    cluster's own kubeconfig with hard timeouts, so a wedged API reports NOT RUN, never
    a verdict.
    """
    rows = []
    guard = pathlib.Path.home() / ".claude" / "scripts" / "no-local-vm-guard.sh"
    rc, out = sh(f"sh {guard}", timeout=15)
    if not guard.exists():
        rows.append("| laptop VM (R26) | NOT RUN | guard missing at ~/.claude/scripts/no-local-vm-guard.sh |")
    elif rc == 0:
        rows.append("| laptop VM (R26) | GREEN | `no-local-vm-guard.sh` -> no colima/lima process, no VM LaunchAgent |")
    else:
        rows.append(f"| laptop VM (R26) | RED | {out.strip().splitlines()[1][:90] if len(out.splitlines()) > 1 else out.strip()[:90]}; stop it, do not restart it |")

    kube = f"KUBECONFIG={pathlib.Path.home() / '.kube' / 'oke-estate'} kubectl --request-timeout=20s"
    rc, out = sh(f"{kube} get nodes --no-headers", timeout=30)
    nodes = [line.split() for line in out.strip().splitlines() if line.strip()]
    if rc or not nodes:
        rows.append(f"| OKE nodes | NOT RUN | `kubectl get nodes` rc={rc} {out.strip()[:80]!r} |")
    else:
        ready = sum(1 for n in nodes if n[1] == "Ready")
        state = "GREEN" if ready == len(nodes) else "RED"
        rows.append(f"| OKE nodes | {state} | `kubectl get nodes` -> {ready}/{len(nodes)} Ready ({nodes[0][4] if len(nodes[0]) > 4 else '?'}) |")

    rc, out = sh(f"{kube} get kustomizations -A --no-headers", timeout=30)
    ks = [line.split() for line in out.strip().splitlines() if line.strip()]
    if rc or not ks:
        rows.append(f"| OKE flux | NOT RUN | `kubectl get kustomizations -A` rc={rc} {out.strip()[:80]!r} |")
    else:
        bad = [k[1] for k in ks if k[3] != "True"]
        if bad:
            rows.append(f"| OKE flux | RED | {len(bad)} of {len(ks)} Kustomizations not ready: {', '.join(bad)} |")
        else:
            rows.append(f"| OKE flux | GREEN | `kubectl get kustomizations -A` -> {len(ks)}/{len(ks)} ready |")
    return rows


#: The one branch this file is read from. STATE.md written anywhere else is written
#: where nobody looks, which is indistinguishable from not writing it at all.
BRANCH = "main"


#: The snapshot commits from its own detached worktree, never from the shared checkout.
#: 2026-08-25: the shared checkout sat on feat/mature-platform-gate for 14 hours and every hourly
#: run refused to commit, so STATE.md on main was 14 hours stale while every session was told to
#: read it first. A worktree pinned to origin/main has no branch for a session to leave it on.
SNAP_WT = pathlib.Path.home() / ".claude" / "state" / "crew-snapshot-worktree"


def ready_to_commit() -> str:
    """"" when the snapshot worktree exists on origin/main, otherwise the reason it does not."""
    rc, out = sh(f"cd '{ROOT}' && git fetch -q origin {BRANCH}", timeout=60)
    if rc:
        return f"git fetch origin {BRANCH} failed: {out.strip()[:200]}"
    if not (SNAP_WT / ".git").exists():
        rc, out = sh(f"cd '{ROOT}' && git worktree prune && git worktree add --detach -q '{SNAP_WT}' origin/{BRANCH}", timeout=60)
        if rc:
            return f"could not create the snapshot worktree at {SNAP_WT}: {out.strip()[:200]}"
    rc, out = sh(f"cd '{SNAP_WT}' && git checkout -q --detach origin/{BRANCH}", timeout=60)
    if rc:
        return f"snapshot worktree could not move to origin/{BRANCH}: {out.strip()[:200]}"
    return ""


def commit(now: str) -> int:
    """Put STATE.md on main from the snapshot worktree, or say exactly which step failed.

    Each step runs on its own and the first failure is named. The worktree is detached at
    origin/main (ready_to_commit), so there is no merge and no branch to be stranded on; a push
    that loses a race with another writer fails loudly here and the next hourly run carries it.
    """
    steps = [
        ("copy STATE.md into the worktree", f"cp '{ROOT / 'STATE.md'}' '{SNAP_WT / 'STATE.md'}'"),
        ("stage STATE.md", "git add STATE.md"),
        ("commit", f"git commit -q -m 'chore(state): estate snapshot {now}'"),
        ("push", f"git push -q origin HEAD:{BRANCH}"),
    ]
    for label, cmd in steps:
        rc, out = sh(f"cd '{SNAP_WT}' && {cmd}", timeout=120)
        if rc != 0:
            if label == "commit" and "nothing to commit" in out:
                print("no change since the last snapshot; nothing to commit.")
                return 0
            print(f"SNAPSHOT NOT COMMITTED. Failed at: {label}\n  {cmd}\n"
                  f"  {out or '(no output)'}")
            return 1
    rc, out = sh(f"cd '{SNAP_WT}' && git log --oneline -1")
    print(f"committed and pushed to {BRANCH}: {out}")
    return 0


def science_plane() -> list[str]:
    """What the research, data-science and ML crew has to stand on, as rows.

    Founder, 2026-08-25: "the fact that you need to check means our process is
    broken." He asked whether a data pipeline exists and the only way to answer
    was to measure the estate by hand. LAW 39: the inventory answers that before
    anyone asks. Every row here is a command; ABSENT is a verdict, not a gap.
    """
    rows: list[str] = []
    sci = ROOT / "science"
    wh = sci / "warehouse.db"
    age = age_hours(wh)
    models = len(list((sci / "dbt" / "models").rglob("*.sql"))) if (sci / "dbt" / "models").exists() else 0
    if age is None:
        rows.append("| science plane: warehouse | ABSENT | no `science/warehouse.db` |")
    else:
        rows.append(f"| science plane: warehouse | {'GREEN' if age < 3 else 'RED'} | DuckDB+dbt, "
                    f"{models} dbt model(s), rebuilt {age:.0f}h ago (`science/warehouse.db`) |")
    _rc, out = sh("pgrep -fl 'dagster' | grep -v pgrep | wc -l", timeout=10)
    n = out.strip() or "0"
    rows.append(f"| science plane: scheduler | {'GREEN' if n.strip() != '0' else 'RED'} | "
                f"Dagster, {n.strip()} process(es) (`pgrep -f dagster`; `idp/scheduler/`) |")
    _rc, out = sh("command -v mlflow || python3 -c 'import mlflow' 2>/dev/null && echo mlflow", timeout=10)
    rows.append("| science plane: experiment tracker | "
                + ("GREEN | mlflow on PATH (`command -v mlflow`) |" if out.strip()
                   else "ABSENT | no MLflow anywhere; R34 names it as the one tracker (`command -v mlflow`) |"))
    pred = sci / "predictions.jsonl"
    if pred.exists():
        lines = [ln for ln in pred.read_text().splitlines() if ln.strip()]
        scored = sum(1 for ln in lines if '"outcome"' in ln or '"actual"' in ln or '"scored"' in ln)
        rows.append(f"| science plane: forecast ledger | {'GREEN' if scored else 'RED'} | "
                    f"{len(lines)} forecast(s), {scored} scored against reality "
                    "(`science/predictions.jsonl`); Brier needs both |")
    else:
        rows.append("| science plane: forecast ledger | ABSENT | no `science/predictions.jsonl` |")
    src = sci / "sources.json"
    if src.exists():
        declared = len(json.loads(src.read_text()).get("sources", []))
        rows.append(f"| science plane: declared stores | {declared} | `science/sources.json` |")
    return rows


def main() -> int:
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    #: Asked before the estate is measured, not after. Measuring takes half a minute and
    #: the answer cannot change the verdict, so a refusal should cost nothing.
    if "--commit" in sys.argv:
        why = ready_to_commit()
        if why:
            print(f"SNAPSHOT NOT COMMITTED: {why}")
            return 1

    rows: list[str] = []
    for fn in (architect, maestro, fly, spend, revenue, delivery, founder, collectors,
        datamap, science_plane, github_actions, crew_p1,
               runtime):
        try:
            rows += fn()
        except Exception as exc:                                # noqa: BLE001
            rows.append(f"| {fn.__name__} | NOT RUN | {type(exc).__name__}: {exc} |")

    body = "\n".join([
        "# Estate snapshot",
        "",
        "**Generated %s** by `scripts/estate-snapshot`. Every row is a command and its",
        "output. A row that could not be measured says NOT RUN, never PASS.",
        "",
        "Read this before asking anyone anything. Regenerate it rather than trusting it:",
        "`scripts/estate-snapshot`.",
        "",
        "| what | state | measured by |",
        "|---|---|---|",
        *rows,
        "",
    ]).replace("%s", now, 1)

    out = ROOT / "STATE.md"
    out.write_text(body)
    print(body)

    if "--commit" in sys.argv:
        return commit(now)
    return 0


if __name__ == "__main__":
    sys.exit(main())
