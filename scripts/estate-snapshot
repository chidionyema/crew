#!/usr/bin/env python3
"""Write the one snapshot every agent and the founder read instead of rediscovering state.

Six sessions cannot see each other. Before this existed each one re-measured the estate
from scratch, and the founder was asked the same questions he had already answered. The
board (crew issues) records decisions; nothing recorded the live state.

Every row here is a command and its output. Nothing is prose about a state, because prose
about a state is how a roadmap came to read "live" while the process ran 32-hour-old code.
A row that could not be measured says NOT RUN, never PASS, because a dead checker and a
healthy estate must never look the same (LAW 31).

    scripts/estate-snapshot            write STATE.md, print it, exit 0
    scripts/estate-snapshot --commit   write, commit and push it to main

`--commit` refuses, loudly and non-zero, unless this checkout is on main with no merge in
progress. It ran hourly from the shared checkout for months without asking where it was,
and on 2026-08-24 it wrote the estate's state onto a feature branch somebody had left
checked out. Everything looked green: it committed, exited 0, and printed "committed:".
STATE.md on main went two and a half hours stale while every session read it and could not
tell. See tests/test_incident_snapshot_committed_to_a_stranded_branch.py.
"""
from __future__ import annotations

import datetime as dt
import json
import pathlib
import re
import subprocess
import sys

#: bin/verify colours its rows. Colour codes in a markdown table render as literal
#: escape bytes on GitHub, which makes the snapshot look broken to the one reader
#: it exists for.
ANSI = re.compile(r"\x1b\[[0-9;]*m")

ROOT = pathlib.Path(__file__).resolve().parent.parent
HOME = pathlib.Path.home()


def sh(cmd: str, timeout: int = 30) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                           timeout=timeout, errors="replace")
        return p.returncode, ANSI.sub("", p.stdout + p.stderr).strip()
    except subprocess.TimeoutExpired:
        return 124, "TIMED OUT after %ds" % timeout
    except Exception as exc:                                    # noqa: BLE001
        return 1, "%s: %s" % (type(exc).__name__, exc)


def age_hours(path: pathlib.Path) -> float | None:
    try:
        import time
        return (time.time() - path.stat().st_mtime) / 3600
    except OSError:
        return None


def architect() -> list[str]:
    d = HOME / "dev/code/hermes-v2"
    if not d.exists():
        return ["| The Architect | NOT RUN | `%s` does not exist |" % d]
    rc, out = sh("cd %s && ./bin/verify 2>&1" % d, timeout=120)
    line = next((l.strip() for l in out.splitlines() if "passed" in l), "")
    fails = [l.strip() for l in out.splitlines() if "FAIL" in l]
    if not line:
        return ["| The Architect | NOT RUN | bin/verify produced no verdict line |"]
    state = "GREEN" if "0 failed" in line or "failed" not in line else "RED"
    rows = ["| The Architect | %s | `bin/verify`: %s |" % (state, line)]
    for f in fails:
        rows.append("| &nbsp;&nbsp;failing | | %s |" % f)
    return rows


def maestro() -> list[str]:
    intents = sorted((HOME / ".maestro/intents").glob("INTENT-*.json"),
                     key=lambda p: p.stat().st_mtime, reverse=True) \
        if (HOME / ".maestro/intents").exists() else []
    if not intents:
        return ["| maestro | NOT RUN | no INTENT files, so nothing has sensed |"]
    a = age_hours(intents[0]) or 99
    state = "GREEN" if a < 0.25 else ("STALE" if a < 2 else "RED")
    rows = ["| maestro | %s | last cycle %.0f min ago (`%s`) |"
            % (state, a * 60, intents[0].name)]
    rc, out = sh("sqlite3 %s 'select count(*) from skills;'" % (HOME / ".maestro/experience_graph.db"))
    rows.append("| &nbsp;&nbsp;skills | %s | %s skill(s) it can heal with |"
                % ("GREEN" if out.isdigit() and int(out) else "RED", out or "NOT RUN"))
    return rows


def fly() -> list[str]:
    rc, out = sh("flyctl apps list 2>&1", timeout=45)
    if rc or "NAME" not in out:
        return ["| Fly | NOT RUN | `flyctl apps list` failed: %s |" % out.splitlines()[0][:80]]
    dep = sum(1 for l in out.splitlines() if "deployed" in l)
    sus = sum(1 for l in out.splitlines() if "suspended" in l)
    rows = ["| Fly | %d deployed, %d suspended | `flyctl apps list` |" % (dep, sus)]

    # Names and dates, not just a count. A count is a pointer to the data and
    # sessions fill the rest in from memory: on 2026-08-24 three of them were
    # passing round "tie suspended since 18 Aug" when tie-api's last release was
    # 13 June, and 18 Aug belonged to prospector-searxng. Naming each dead app
    # and the day it last shipped is what stops that (crew#118).
    dead = []
    for line in out.splitlines():
        cells = [c.strip() for c in line.split("│")]
        if len(cells) < 4 or "suspended" not in cells[2]:
            continue
        name, when = cells[0], cells[3]
        if when:                       # no date means it never shipped at all
            dead.append((name, when))
    for name, when in sorted(dead, key=lambda p: p[0]):
        rows.append("| &nbsp;&nbsp;%s | suspended, last release %s | R1: it does not come "
                    "back on Fly |" % (name, when))
    return rows


def crew_p1() -> list[str]:
    rc, out = sh("gh issue list --repo chidionyema/crew --state open --label P1 "
                 "--json number,title -q '.[] | \"#\\(.number) \\(.title)\"'", timeout=45)
    if rc:
        return ["| crew P1 | NOT RUN | `gh issue list` failed |"]
    items = [l for l in out.splitlines() if l.strip()]
    if not items:
        return ["| crew P1 | GREEN | no open P1 issues |"]
    rows = ["| crew P1 | %d open | the fires nobody has put out |" % len(items)]
    for i in items:
        rows.append("| &nbsp;&nbsp;%s | | |" % i.replace("|", "/")[:110])
    return rows


def spend() -> list[str]:
    """The money row, read from the science warehouse.

    This is the reader `science/collect.py` was built for. The number reaches the
    founder here and nowhere else, because a spend series he has to query is a
    spend series he will not look at (LAW 31).
    """
    db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
    if not db.exists():
        return ["| estate spend | NOT RUN | no warehouse: run `science/collect.py` |"]
    rc, out = sh("sqlite3 %s \"select round(avg(usd),0) from "
                 "(select usd from spend_daily order by day desc limit 7);\"" % db, timeout=20)
    if rc or not out.strip():
        return ["| estate spend | NOT RUN | `spend_daily` view did not answer |"]
    try:
        rate = float(out.strip())
    except ValueError:
        return ["| estate spend | NOT RUN | `spend_daily` returned %r |" % out.strip()[:40]]
    cap = 120.0
    state = "GREEN" if rate <= cap else "RED"
    return ["| estate spend | %s | $%.0f/day 7-day mean against a $%.0f cap "
            "(`spend_daily`, %s) |" % (state, rate, cap, db.name)]


def _broadcast_strands(per_repo: list[tuple[int, float, int, str]], now: float) -> None:
    """Tell the lane that owns a strand, once a day, on the channel it already reads.

    A RED row on a page is pull, and the session that stranded the work never pulls.
    The estate board is injected into every session at prompt time, so a row here
    reaches the owning lane without anyone polling (crew #97 phase 2a). One row per
    repo per day; the dedup key is the repo name before the colon.
    """
    board = HOME / ".claude/ESTATE_BOARD.jsonl"
    caster = HOME / ".claude/scripts/estate-broadcast.py"
    if not caster.exists():
        return
    try:
        seen = set()
        cutoff = now - 24 * 3600
        lines = board.read_text().splitlines()[-500:] if board.exists() else []
        for line in lines:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("from") != "estate-delivery" or row.get("kind") != "stranded":
                continue
            try:
                ts = dt.datetime.fromisoformat(
                    str(row.get("ts") or row.get("timestamp")).replace("Z", "+00:00"))
            except ValueError:
                continue
            if ts.timestamp() >= cutoff:
                seen.add(str(row.get("message", "")).split(":", 1)[0])
        for n, oldest, _dirty, name in per_repo:
            if n and oldest > 1.0 and name not in seen:
                sh("python3 '%s' --from estate-delivery --kind stranded --message "
                   "'%s: %d commits on no remote, oldest %.1fd. Push the branch or say "
                   "on crew #97 why it must stay local.'" % (caster, name, n, oldest),
                   timeout=20)
    except OSError:
        pass


def delivery() -> list[str]:
    """What the fleet shipped against what it stranded.

    First run, 2026-08-24 (crew #97): 32 commits sat on branches no remote holds,
    the oldest 7.7 days old — and the estate board's last 24 hours held 130
    guard-broken rows and not one row saying anything shipped. The spend row above is rebuilt hourly; nothing measured
    what the spend bought. A pipeline nobody measures is how "cost drain not
    delivering" stayed a feeling instead of a number (LAW 28).

    Stranded means commits reachable from a local branch and from no remote ref —
    work that dies with this laptop. Dormant repos (no commit anywhere in 30 days)
    are dead weight, not stranded work, and are excluded.
    """
    candidates = sorted(HOME.glob("dev/code/*")) + [
        HOME / ".claude/scripts", HOME / ".claude",
        HOME / "Documents/code/prospector"]
    now = dt.datetime.now(dt.timezone.utc).timestamp()
    seen: set[str] = set()
    per_repo: list[tuple[int, float, int, str]] = []
    for d in candidates:
        if not (d / ".git").exists():
            continue
        rc, url = sh("git -C '%s' remote get-url origin" % d, timeout=10)
        key = url if not rc and url else str(d)
        if key in seen:            # prospector has two checkouts of one repo
            continue
        seen.add(key)
        rc, last = sh("git -C '%s' log -1 --format=%%ct --all" % d, timeout=10)
        if rc or not last.isdigit() or now - int(last) > 30 * 86400:
            continue
        rc, out = sh("git -C '%s' log --branches --not --remotes --format=%%ct" % d,
                     timeout=20)
        cts = [int(t) for t in out.split() if t.isdigit()]
        rc, st = sh("git -C '%s' status --porcelain" % d, timeout=20)
        dirty = len([l for l in st.splitlines() if l.strip()])
        if cts or dirty:
            oldest = (now - min(cts)) / 86400 if cts else 0.0
            per_repo.append((len(cts), oldest, dirty, d.name))

    _broadcast_strands(per_repo, now)

    stranded = sum(r[0] for r in per_repo)
    oldest = max((r[1] for r in per_repo), default=0.0)
    dirty = sum(r[2] for r in per_repo)

    since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=7)).strftime("%Y-%m-%d")
    # Bot bumps are not the fleet delivering; a capped count is a floor, not a count.
    cap = 1000
    rc, out = sh("gh search prs --owner chidionyema --merged --merged-at '>=%s' "
                 "-L %d --json number --jq length -- -author:app/dependabot"
                 % (since, cap), timeout=45)
    merged = int(out) if not rc and out.isdigit() else None

    state = "GREEN" if stranded == 0 else ("STALE" if oldest < 1 else "RED")
    rows = ["| delivery | %s | %d commits on no remote (oldest %.1fd), %d dirty files, "
            "%d live repos (`git log --branches --not --remotes`) |"
            % (state, stranded, oldest, dirty, len(per_repo))]
    if merged is None:
        rows.append("| &nbsp;&nbsp;shipped | NOT RUN | `gh search prs --merged` "
                    "did not answer |")
    else:
        cost = ""
        db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
        rc, rate = sh("sqlite3 %s \"select round(avg(usd),0) from (select usd from "
                      "spend_daily order by day desc limit 7);\"" % db, timeout=20)
        try:
            if not rc and merged:
                cost = ", ~$%.0f of estate spend per shipped change" % (
                    7 * float(rate) / merged)
        except ValueError:
            pass
        shown = str(merged) if merged < cap else ">=%d" % merged
        if merged >= cap:
            cost = ""
        rows.append("| &nbsp;&nbsp;shipped | %s merged | non-bot PRs merged across the "
                    "estate in 7d%s (`gh search prs`) |" % (shown, cost))
    for n, old, dr, name in sorted(per_repo, reverse=True)[:3]:
        if n:
            rows.append("| &nbsp;&nbsp;stranded | %s | %d commits no remote holds, "
                        "oldest %.1fd, %d dirty |" % (name, n, old, dr))
    return rows


def founder() -> list[str]:
    """What the estate cost HIM this week, against last week.

    Every other row on this page measures the estate. This one measures the person it is
    for. LAW 36 says the complaint is the measurement and not a mood, and until 2026-08-24
    nothing kept a series of them: `friction-relay.py` holds six hours and is rebuilt at
    every session start, so "is this getting better or worse" had no answer.

    Two numbers, both his: how many messages the estate needed from him, and what share of
    them were complaints. Falling messages with a flat complaint rate is the estate needing
    him less. A rising complaint rate is the platform telling on itself.
    """
    db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
    if not db.exists():
        return ["| founder cost | NOT RUN | no warehouse at %s |" % db.name]
    rc, out = sh("sqlite3 -separator '\t' %s \"select day, messages, complaints "
                 "from attention_daily order by day desc limit 14;\"" % db, timeout=20)
    if rc or not out.strip():
        return ["| founder cost | NOT RUN | `attention_daily` did not answer |"]
    days = []
    for line in out.strip().split("\n"):
        p = line.split("\t")
        if len(p) == 3:
            try:
                days.append((p[0], int(p[1]), int(p[2])))
            except ValueError:
                continue
    if len(days) < 4:
        return ["| founder cost | NOT RUN | only %d days collected, needs 4 |" % len(days)]

    this, prev = days[:7], days[7:14]
    def rate(rows):
        m = sum(r[1] for r in rows) or 1
        return sum(r[2] for r in rows), m, 100.0 * sum(r[2] for r in rows) / m
    c1, m1, r1 = rate(this)
    if not prev:
        return ["| founder cost | %d msgs | %d complaints, %.0f%%, last %d days "
                "(`attention_daily`) |" % (m1, c1, r1, len(this))]
    c0, m0, r0 = rate(prev)
    # A complaint rate that rose is the platform getting worse for the one person it is
    # for, whatever the other rows on this page say.
    state = "GREEN" if r1 <= r0 else "RED"
    return ["| founder cost | %s | %d msgs / %.0f%% complaints this week against "
            "%d / %.0f%% last (`attention_daily`) |" % (state, m1, r1, m0, r0)]


def collectors() -> list[str]:
    """Which of the estate's data stores have stopped being written.

    Two were already dead when the warehouse was built — `would-have-fired.jsonl`
    had been silent 49 hours and `DECISIONS.jsonl` 54, and nothing anywhere said
    so. `collect.py --check` finds them and exits 1, but it exits 1 into a log
    file, and a log file is not a reader (LAW 28). This is the reader.

    It reports NOT RUN, never GREEN, when the collector itself has stopped, because
    a board that cannot tell "everything is fine" from "nobody checked" is worse
    than no board.
    """
    db = pathlib.Path(__file__).resolve().parent.parent / "science" / "warehouse.db"
    if not db.exists():
        return ["| collectors | NOT RUN | no warehouse at %s |" % db.name]
    rc, out = sh("sqlite3 -separator '\t' %s \"select source, source_mtime, status, "
                 "max(ingested_at) from ingest_log group by source;\"" % db, timeout=20)
    if rc or not out.strip():
        return ["| collectors | NOT RUN | `ingest_log` did not answer |"]

    now = dt.datetime.now(dt.timezone.utc)
    dead, newest_ingest = [], None
    for line in out.strip().split("\n"):
        parts = line.split("\t")
        if len(parts) < 4:
            continue
        source, mtime, status, ingested = parts[0], parts[1], parts[2], parts[3]
        try:
            ing = dt.datetime.fromisoformat(ingested)
            newest_ingest = max(newest_ingest, ing) if newest_ingest else ing
        except ValueError:
            pass
        if status != "OK":
            dead.append("%s %s" % (source, status))
            continue
        try:
            age_h = (now - dt.datetime.fromisoformat(mtime)).total_seconds() / 3600
        except ValueError:
            continue
        # 48h is collect.py's own default. Anything quieter than two full days is a
        # collector that stopped, not a quiet period.
        if age_h > 48:
            dead.append("%s silent %.0fh" % (source, age_h))

    # The collector runs hourly. If its own last run is older than three of those,
    # the rows above are stale and this row must not claim to have checked anything.
    if newest_ingest is None:
        return ["| collectors | NOT RUN | `ingest_log` holds no timestamp |"]
    since_h = (now - newest_ingest).total_seconds() / 3600
    if since_h > 3:
        return ["| collectors | NOT RUN | warehouse last rebuilt %.0fh ago; "
                "`com.founder.sciencecollect` is not running |" % since_h]

    if dead:
        return ["| collectors | RED | %d of the estate's data stores stopped being "
                "written: %s |" % (len(dead), "; ".join(dead[:4]))]
    return ["| collectors | GREEN | every data store written inside 48h "
            "(`ingest_log`, checked %.0fh ago) |" % since_h]


def runtime() -> list[str]:
    """One container runtime -- colima -- and the CLI pointing at it, and it answering.

    Incident 2026-08-24: Docker Desktop ran beside colima for hours holding zero
    containers, the default docker context pointed at Desktop's dead daemon, and
    `docker ps` hung for minutes in every session that tried. No instrument said so;
    the founder found it by asking. The class is a second runtime nobody chose and a
    context nobody checked, so this row measures three things and is GREEN only when
    all three hold: context is colima, no second runtime process, colima's dockerd
    actually answers. The socket probe uses curl with a hard timeout because the
    docker CLI blocks unboundedly against a wedged daemon -- that hang WAS the
    incident, and an instrument that hangs the same way measures nothing.
    """
    rows = []
    rc, ctx = sh("docker context show", timeout=15)
    ctx = ctx.strip()
    if rc:
        rows.append("| docker context | NOT RUN | `docker context show` rc=%d |" % rc)
    elif ctx == "colima":
        rows.append("| docker context | GREEN | `docker context show` -> colima |")
    else:
        rows.append("| docker context | RED | `docker context show` -> %s; sessions'"
                    " docker commands are landing off the standard runtime |" % ctx)

    # macOS pgrep has no -c; count with wc. A non-numeric answer is NOT RUN, never a
    # verdict -- the first draft of this row read pgrep's usage error as a count.
    rc, n = sh("pgrep -f 'Docker.app/Contents/MacOS' | wc -l", timeout=10)
    n = n.strip()
    if not n.isdigit():
        rows.append("| second container runtime | NOT RUN | pgrep gave %r |" % n[:60])
    elif n != "0":
        rows.append("| second container runtime | RED | Docker Desktop is running "
                    "beside colima (%s processes); one of them is paying for a VM "
                    "nothing uses |" % n)
    else:
        rows.append("| second container runtime | GREEN | `pgrep -f "
                    "'Docker.app/Contents/MacOS' | wc -l` -> 0 |")

    sock = pathlib.Path.home() / ".colima" / "default" / "docker.sock"
    rc, out = sh("curl -s --max-time 8 --unix-socket %s "
                 "http://localhost/v1.43/containers/json" % sock, timeout=15)
    if rc == 0 and out.startswith("["):
        rows.append("| colima dockerd | GREEN | socket answered containers/json |")
    else:
        rows.append("| colima dockerd | RED | socket gave %s in 8s -- every estate "
                    "container is unserved; do NOT restart colima, route to the "
                    "firefighter |" % ("nothing" if not out else "rc=%d" % rc))
    return rows


#: The one branch this file is read from. STATE.md written anywhere else is written
#: where nobody looks, which is indistinguishable from not writing it at all.
BRANCH = "main"


def ready_to_commit() -> str:
    """"" when this checkout may be committed to, otherwise the reason it may not.

    INCIDENT, 2026-08-24. This job runs hourly from the shared checkout
    `~/dev/code/crew`, and it committed to whatever branch that checkout happened to be
    standing on. A session left it on `research-gateway-api-edge` mid-merge, so the 08:34
    UTC snapshot was committed onto a feature branch and STATE.md on main went 2.5 hours
    stale. STATE.md is the file every session is told to read before measuring anything or
    asking the founder anything -- it exists so that six sessions which cannot see each
    other stop re-measuring the same estate. While it is stale, every session reading it
    is reading a stale estate and none of them can tell.

    The job reported nothing wrong throughout. It committed successfully and exited 0,
    because it never asked where it was. An instrument that cannot tell "I wrote the
    estate's state" from "I wrote onto a branch nobody reads" is blind in the same way a
    checker that cannot tell "the directory is gone" from "I could not read it" is blind
    (science/collect.py, same day, four other instances). This is the two-line version.

    Refusing is the whole point. A snapshot not written is visible in the timestamp; a
    snapshot written somewhere else looks exactly like success.
    """
    rc, branch = sh("git -C '%s' rev-parse --abbrev-ref HEAD" % ROOT)
    if rc:
        return "cannot read the current branch: %s" % branch
    if branch != BRANCH:
        return ("this checkout is on '%s', not %s. The snapshot would be committed where "
                "nobody reads it. Move the work to a worktree and return the checkout to "
                "%s." % (branch, BRANCH, BRANCH))
    rc, _ = sh("git -C '%s' rev-parse -q --verify MERGE_HEAD" % ROOT)
    if rc == 0:
        return ("a merge is in progress in this checkout. Committing into it would add "
                "the snapshot to somebody's half-finished merge.")
    rc, out = sh("git -C '%s' status --porcelain -- STATE.md" % ROOT)
    if rc:
        return "cannot read the status of STATE.md: %s" % out
    return ""


def commit(now: str) -> int:
    """Put STATE.md on main, or say exactly which step failed. Never both.

    The previous version was one `&&` chain whose result was thrown away, followed by a
    separate `git log -1` printed as "committed:". A failed push and a successful one
    printed the same line. Worse, the chain ended with a bare `git merge origin/main`,
    which is what authored the conflicted merge that stranded the checkout in the first
    place -- the job's own recovery step was the thing that broke it.

    So: fast-forward BEFORE writing anything, never merge after; run each step on its own
    and stop at the first failure; and name the step that failed. A push that loses a race
    with another writer fails loudly here and the next hourly run carries the state -- an
    hour of staleness that is visible beats a merge nobody asked for.
    """
    steps = [
        ("fetch main", "git fetch -q origin %s" % BRANCH),
        ("fast-forward onto origin/%s" % BRANCH,
         "git merge --ff-only -q origin/%s" % BRANCH),
        ("stage STATE.md", "git add STATE.md"),
        ("commit", "git commit -q -m 'chore(state): estate snapshot %s'" % now),
        ("push", "git push -q origin %s" % BRANCH),
    ]
    for label, cmd in steps:
        rc, out = sh("cd '%s' && %s" % (ROOT, cmd), timeout=120)
        if rc != 0:
            #: "nothing to commit" is not a failure. The estate can be unchanged between
            #: two hourly runs, and a job that goes red on a quiet hour gets ignored on
            #: the hour it means it.
            if label == "commit" and "nothing to commit" in out:
                print("no change since the last snapshot; nothing to commit.")
                return 0
            print("SNAPSHOT NOT COMMITTED. Failed at: %s\n  %s\n  %s"
                  % (label, cmd, out or "(no output)"))
            return 1
    rc, out = sh("cd '%s' && git log --oneline -1" % ROOT)
    print("committed and pushed to %s: %s" % (BRANCH, out))
    return 0


def main() -> int:
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    #: Asked before the estate is measured, not after. Measuring takes half a minute and
    #: the answer cannot change the verdict, so a refusal should cost nothing.
    if "--commit" in sys.argv:
        why = ready_to_commit()
        if why:
            print("SNAPSHOT NOT COMMITTED: %s" % why)
            return 1

    rows: list[str] = []
    for fn in (architect, maestro, fly, spend, delivery, founder, collectors, crew_p1,
               runtime):
        try:
            rows += fn()
        except Exception as exc:                                # noqa: BLE001
            rows.append("| %s | NOT RUN | %s: %s |" % (fn.__name__, type(exc).__name__, exc))

    body = "\n".join([
        "# Estate snapshot",
        "",
        "**Generated %s** by `scripts/estate-snapshot`. Every row is a command and its",
        "output. A row that could not be measured says NOT RUN, never PASS.",
        "",
        "Read this before asking anyone anything. Regenerate it rather than trusting it:",
        "`scripts/estate-snapshot`.",
        "",
        "| what | state | measured by |",
        "|---|---|---|",
        *rows,
        "",
    ]).replace("%s", now, 1)

    out = ROOT / "STATE.md"
    out.write_text(body)
    print(body)

    if "--commit" in sys.argv:
        return commit(now)
    return 0


if __name__ == "__main__":
    sys.exit(main())
