#!/usr/bin/env python3
"""hazard-register: the forward hazard register, rendered and cross-checked (crew#495 CP2).

Founder, 2026-08-27: "we need this definitely: a trace matrix, a forward hazard register".
The register already exists, risk/REGISTER.jsonl, and two gates keep its shape honest
(scripts/verify.d/85, 86). What was missing is the forward half: the page a buyer reads,
generated so it cannot drift, and the link from a hazard to the incident that realised it.

    scripts/hazard-register            render docs/reference/HAZARDS.md from the register
    scripts/hazard-register --check    also read every open P1 in the estate repos and exit 1
                                       when one names no register row (R<n>): a fire with
                                       no hazard behind it is a hazard nobody wrote down
    --issues FILE                      P1 issues as JSON (what `gh issue list --json` prints)
                                       instead of calling gh; the test uses this

Report mode: verify.d runs it without --check and prints the counts.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("CREW_ROOT") or Path(__file__).resolve().parent.parent)
REG = ROOT / "risk" / "REGISTER.jsonl"
PAGE = ROOT / "docs" / "reference" / "HAZARDS.md"
REPOS = os.environ.get("HAZARD_REPOS", "chidionyema/crew,chidionyema/idp").split(",")
RID = re.compile(r"\bR(\d+)\b")
RANK = {"certain": 0, "high": 1, "medium": 2, "low": 3}


def rows(path: Path) -> list[dict]:
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def rank(r: dict) -> tuple:
    like = r["likelihood"].lower()
    n = next((v for k, v in RANK.items() if like.startswith(k)), 4)
    return (0 if r["status"] == "open" else 1, n, int(m.group(1)) if (m := RID.search(r["id"])) else 0)


def p1_issues(path: Path | None) -> list[dict]:
    if path:
        return json.loads(path.read_text())
    out = []
    for repo in REPOS:
        res = subprocess.run(["gh", "issue", "list", "-R", repo, "-l", "P1", "-s", "open", "-L", "200",
                              "--json", "number,title,body,url"], capture_output=True, text=True, check=False)
        if res.returncode != 0:
            print(f"BLIND hazard-register cannot list P1 issues in {repo}: {res.stderr.strip()[:120]}")
            continue
        out += [{**i, "repo": repo} for i in json.loads(res.stdout or "[]")]
    return out


def names_hazard(issue: dict, ids: set[str]) -> bool:
    return any(f"R{m.group(1)}" in ids for m in RID.finditer(issue.get("body") or ""))


def cell(s: object) -> str:
    return str(s).replace("|", "\\|").replace("\n", " ")


def render(reg: list[dict], issues: list[dict], realised: dict[str, list[dict]]) -> str:
    ids = {r["id"] for r in reg}
    open_rows = [r for r in reg if r["status"] == "open"]
    lines = [
        "# Hazard register",
        "",
        "GENERATED by `scripts/hazard-register` from `risk/REGISTER.jsonl` and the open P1 issues of "
        + ", ".join(REPOS) + ". Open hazards first, most likely first. Do not edit by hand; edit the register.",
        "",
        "## The bar",
        "",
        f"- Hazards: **{len(open_rows)} open**, {len(reg) - len(open_rows)} mitigated, closed or accepted, of {len(reg)}",
        f"- Open P1 fires: **{len(issues)}**, {sum(1 for i in issues if names_hazard(i, ids))} name the hazard they realised",
        "",
        "| Id | Status | Likelihood | Hazard | What goes wrong | Mitigation | Residual | Realised by | Owner |",
        "|---|---|---|---|---|---|---|---|---|",
    ]
    for r in sorted(reg, key=rank):
        fires = "<br>".join(f"[{i['repo'].split('/')[-1]}#{i['number']}]({i['url']})" for i in realised.get(r["id"], [])) or "not yet"
        lines.append("| " + " | ".join(cell(x) for x in (r["id"], r["status"], r["likelihood"], r["title"], r["what_goes_wrong"],
                                                      r["mitigation"], r["residual"], fires, r["owner"])) + " |")
    unnamed = [i for i in issues if not names_hazard(i, ids)]
    lines += ["", "## Fires with no hazard behind them", ""]
    lines += [f"- [{i['repo'].split('/')[-1]}#{i['number']}]({i['url']}) {cell(i['title'])}" for i in unnamed] or ["- none"]
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="forward hazard register: page plus P1 cross-check")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--issues", type=Path)
    ap.add_argument("--out", type=Path, default=PAGE)
    a = ap.parse_args(argv)
    reg = rows(REG)
    ids = {r["id"] for r in reg}
    issues = p1_issues(a.issues)
    realised: dict[str, list[dict]] = {}
    for i in issues:
        for m in RID.finditer(i.get("body") or ""):
            if f"R{m.group(1)}" in ids:
                realised.setdefault(f"R{m.group(1)}", []).append(i)
    a.out.parent.mkdir(parents=True, exist_ok=True)
    a.out.write_text(render(reg, issues, realised))
    unnamed = [i for i in issues if not names_hazard(i, ids)]
    n_open = sum(1 for r in reg if r["status"] == "open")
    word = "FAIL " if (a.check and unnamed) else "ok   "
    print(f"{word} hazard-register  {n_open} open of {len(reg)} hazards; {len(issues)} open P1, {len(unnamed)} name no hazard -> {a.out}")
    for i in unnamed:
        print(f"      {i['repo']}#{i['number']} {i['title'][:80]}")
    return 1 if (a.check and unnamed) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
