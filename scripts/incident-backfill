#!/usr/bin/env python3
"""crew#668 CP2: the retroactive audit. Every ``tests/test_incident_*`` guard in the estate is an
incident somebody already paid for; this turns the file names and their first commits into rows
of ``incidents/GUARDS.jsonl`` so the page can rank what keeps going wrong.

Rejected: a hand-written backfill -- 445 files is a generator's job, and a hand-written row drifts
the day a guard is renamed. Standard: Developer platform (generated ledger, the hazard-register road).

    scripts/incident-backfill --repo crew=. --repo idp=../idp --repo hermes-v2=../hermes-v2

Each repo path is given on the command line; nothing here names a checkout or a home (LAW 46).
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

# Keyword -> class, in priority order. A guard whose title matches none is "unclassified" and the
# page counts those loudly: an unclassified guard is one the estate cannot learn from yet.
KEYWORDS: list[tuple[str, str]] = [
    (r"secret|token|credential|password|leak", "secret-in-chat"),
    (r"hardcod|home_dir|literal|absolute_path|named_a_file|machine", "hardcoded-path"),
    (r"blind|silent|reported_pass|read_green|could_not_parse|swallow|green_when", "silent-green"),
    (r"stale|summary|memory|from_memory|transcript|out_of_date|drift", "summary-over-source"),
    (r"gate|hook|guard|fence|refus|landed_after|branch", "gate-landed-after-branch"),
    (r"wrong_surface|laptop|mac_|local_only|worktree|fixture", "fix-proved-on-the-wrong-surface"),
    (r"alert|nobody|unread|instrument|receipt|log_|metric|notif", "instrument-nobody-reads"),
    (r"repeat|again|twice|third_time|founder_said|screaming", "founder-repeat"),
    (r"single|one_node|spof|only_node|lock", "single-point-of-failure"),
    (r"law|rule|protocol|wish|policy", "rule-without-guard"),
]

TICKET = re.compile(r"^(?P<repo>crew|idp|hv2|cg|estate)?(?P<n>\d+)(?P<suffix>[a-z])?(?:_|$)")


def classify(title: str) -> str:
    for pat, cls in KEYWORDS:
        if re.search(pat, title):
            return cls
    return "unclassified"


def first_commit(repo: Path, rel: str) -> tuple[str, str]:
    out = (
        subprocess.run(
            ["git", "-C", str(repo), "log", "--diff-filter=A", "--format=%h %cI", "--", rel],
            capture_output=True,
            text=True,
            check=False,
        )
        .stdout.strip()
        .splitlines()
    )
    if not out:
        return "", ""
    sha, at = out[-1].split(" ", 1)
    return sha, at


def rows_for(name: str, repo: Path) -> list[dict]:
    files = subprocess.run(
        ["git", "-C", str(repo), "ls-files", "tests/test_incident_*"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()
    rows = []
    for rel in files:
        stem = Path(rel).stem.removeprefix("test_incident_")
        m = TICKET.match(stem)
        ticket = ""
        title = stem
        if m:
            tr = m.group("repo") or name
            tr = {"hv2": "hermes-v2", "cg": "claude-guards"}.get(tr, tr)
            ticket = f"{tr}#{m.group('n')}"
            title = stem[m.end() :]
        sha, at = first_commit(repo, rel)
        rows.append(
            {
                "repo": name,
                "guard": rel,
                "ticket": ticket,
                "title": title.replace("_", " ").strip(),
                "class": classify(stem),
                "first_commit": sha,
                "guarded_at": at,
            }
        )
    return rows


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--repo", action="append", required=True, help="NAME=PATH, repeatable")
    ap.add_argument("--out", default="incidents/GUARDS.jsonl")
    a = ap.parse_args()
    rows: list[dict] = []
    for spec in a.repo:
        name, _, path = spec.partition("=")
        p = Path(path)
        if not (p / ".git").exists() and not (p / ".git").is_file():
            print(f"FAIL  incident-backfill  {name}: {p} is not a git checkout", file=sys.stderr)
            return 1
        rows += rows_for(name, p)
    rows.sort(key=lambda r: (r["repo"], r["guard"]))
    Path(a.out).write_text("".join(json.dumps(r) + "\n" for r in rows))
    unclassified = sum(r["class"] == "unclassified" for r in rows)
    print(
        f"ok    incident-backfill  {len(rows)} guards from {len(a.repo)} repos; {unclassified} unclassified -> {a.out}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
