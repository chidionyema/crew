#!/usr/bin/env python3
"""incident-report: the incident ledger, rendered and kept honest (crew#668 CP1).

Founder, 2026-08-30: "incident reports are learning opportunity and training data for estate",
"the estate itself can learn", "this store of knowledge can be analysed for what not to do".
The ledger is incidents/LEDGER.jsonl, one row per incident, machine-readable. This renders
docs/INCIDENTS.md from it, same road as scripts/hazard-register, and refuses a row that
teaches nothing: no class, no guard, no receipt, or a hazard id the register does not hold.

    scripts/incident-report            render docs/INCIDENTS.md
    scripts/incident-report --check    also exit 1 on a row that teaches nothing
    --out FILE                         write the page elsewhere (tests)
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LEDGER = ROOT / "incidents" / "LEDGER.jsonl"
REGISTER = ROOT / "risk" / "REGISTER.jsonl"
PAGE = ROOT / "docs" / "INCIDENTS.md"
CLASSES = {
    "gate-landed-after-branch": "a CI rule merged after the branch was cut; local runs stay green",
    "fix-proved-on-the-wrong-surface": "the fix was proved on a Mac or a test and failed on the cluster",
    "instrument-nobody-reads": "a log, alert or finding existed and no person or job read it (LAW 28)",
    "summary-over-source": "a compaction summary or memory was trusted over the file or the vendor page",
    "silent-green": "a check reads green when it cannot measure (LAW 15)",
    "hardcoded-path": "a path, host, port or account typed as a literal (LAW 46)",
    "secret-in-chat": "a credential in a message, transcript or log (R49)",
    "rule-without-guard": "a law or ruling with no test or hook that can stop a session (LAW 44)",
    "founder-repeat": "the founder had to say something again (R2)",
    "single-point-of-failure": "one machine, provider, account or person held the whole path",
}
NEEDS = (
    "id",
    "title",
    "surface",
    "detected",
    "timeline",
    "root_cause",
    "classes",
    "laws",
    "guard",
    "hazard",
    "traced",
)


def rows(path: Path) -> list[dict]:
    return [json.loads(ln) for ln in path.read_text(encoding="utf-8").splitlines() if ln.strip()]


def faults(r: dict, hazards: set[str]) -> list[str]:
    out = [f"missing {k}" for k in NEEDS if k not in r or r[k] in (None, "", [])]
    out += [f"unknown class {c}" for c in r.get("classes", []) if c not in CLASSES]
    if not any(t.get("receipt") for t in r.get("timeline", [])):
        out.append("no receipt on any timeline entry")
    if r.get("hazard") and r["hazard"] not in hazards:
        out.append(f"hazard {r['hazard']} is not on risk/REGISTER.jsonl")
    return out


def cell(s: object) -> str:
    return str(s).replace("|", "\\|").replace("\n", " ")


def render(led: list[dict], bad: dict[str, list[str]]) -> str:
    open_rows = [r for r in led if not r.get("resolved")]
    by_class: dict[str, list[dict]] = {}
    for r in led:
        for c in r.get("classes", []):
            by_class.setdefault(c, []).append(r)
    lines = [
        "# Incident ledger",
        "",
        "GENERATED by `scripts/incident-report` from `incidents/LEDGER.jsonl`. Do not edit by hand; edit the ledger.",
        "Every row is a traced outage with its receipts, its class, the law it broke and the guard that closes it.",
        "",
        "## The bar",
        "",
        f"- Incidents: **{len(open_rows)} open**, {len(led) - len(open_rows)} resolved, of {len(led)}",
        f"- Hours dark, all rows: **{sum(float(r.get('hours_dark') or 0) for r in led):g}**",
        f"- Rows that teach nothing (no class, guard or receipt): **{len(bad)}**",
        "",
        "## What not to do, ranked by hours dark",
        "",
        "| Class | Means | Incidents | Hours dark | Guarded |",
        "|---|---|---|---|---|",
    ]
    ranked = sorted(
        by_class.items(), key=lambda kv: -sum(float(r.get("hours_dark") or 0) for r in kv[1])
    )
    for c, rs in ranked:
        hours = sum(float(r.get("hours_dark") or 0) for r in rs)
        guarded = "yes" if all(r.get("guard") for r in rs) else "**NO GUARD**"
        lines.append(
            f"| {c} | {cell(CLASSES.get(c, '**unknown class**'))} | {', '.join(r['id'] for r in rs)} | {hours:g} | {guarded} |"
        )
    lines += ["", "## Incidents, newest first", ""]
    for r in sorted(led, key=lambda r: r["detected"], reverse=True):
        state = "open" if not r.get("resolved") else f"resolved {r['resolved']}"
        lines += [
            f"### {r['id']} — {cell(r['title'])}",
            "",
            f"- Surface: {cell(r['surface'])}; detected {r['detected']} by {cell(r.get('detected_by', '?'))}; {state}; traced: {r['traced']}",
            f"- Root cause: {cell(r['root_cause'])}",
            f"- Class: {', '.join(r['classes'])}; laws: {', '.join(str(x) for x in r['laws'])}; hazard: {r['hazard']}; hours dark: {r.get('hours_dark', '?')}",
            f"- Guard: `{cell(r['guard'])}`" + (f"; issue: {r['issue']}" if r.get("issue") else ""),
        ]
        if r.get("founder_words"):
            lines.append(f'- Founder, verbatim: "{cell(r["founder_words"])}"')
        lines += ["", "| When | What | Receipt |", "|---|---|---|"]
        lines += [
            f"| {t['at']} | {cell(t['what'])} | {t.get('receipt', '')} |" for t in r["timeline"]
        ]
        if bad.get(r["id"]):
            lines += ["", "**Teaches nothing:** " + "; ".join(bad[r["id"]])]
        lines.append("")
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="incident ledger: page plus teaches-nothing check")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--ledger", type=Path, default=LEDGER)
    ap.add_argument("--out", type=Path, default=PAGE)
    a = ap.parse_args(argv)
    led = rows(a.ledger)
    hazards = {r["id"] for r in rows(REGISTER)} if REGISTER.exists() else set()
    bad = {r["id"]: f for r in led if (f := faults(r, hazards))}
    a.out.parent.mkdir(parents=True, exist_ok=True)
    a.out.write_text(render(led, bad))
    n_open = sum(1 for r in led if not r.get("resolved"))
    word = "FAIL " if (a.check and bad) else "ok   "
    print(
        f"{word} incident-report  {n_open} open of {len(led)} incidents; {len(bad)} teach nothing -> {a.out}"
    )
    for i, f in bad.items():
        print(f"      {i}: {'; '.join(f)}")
    return 1 if (a.check and bad) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
