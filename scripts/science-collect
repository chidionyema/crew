#!/bin/bash
# Rebuild the science warehouse, hourly, so nobody ever runs a collector by hand.
#
# LAW 31: the founder does not run scripts. Before this existed, collect.py was a
# one-off — it had produced exactly one warehouse, on the day it was written, and
# the spend row in STATE.md would have gone stale the moment that file aged out.
#
# Order matters and is the whole reason this is a wrapper rather than two plists.
# outcomes.py writes ships.jsonl; collect.py ingests it. Running them as separate
# scheduled jobs would race, and the value_daily view would show a day of spend
# against yesterday's commit count with nothing saying so.
#
#   1. outcomes.py ship   collect what the estate produced (git + gh)
#   2. outcomes.py attention  collect what it cost the founder (his own words)
#   3. collect.py --check rebuild the warehouse, exit 1 if a source is stale
#   4. foresight.py       pull CI history, score yesterday's predictions, predict today's open PRs (crew#405)
#   5. showcase.py        regenerate docs/science/SHOWCASE.md from the stores just written (crew#403)
#
# A non-zero exit is the point, not a failure of this script: it means a source
# stopped being written and somebody needs to look. It lands in the .err.log and
# in the collector's own stdout, both named in docs/how-to/onboarding/collect.md.
set -uo pipefail

# foresight needs scikit-learn, which lives in the repo venv, not the system python3 (crew#404).
PY="${CREW_PYTHON:-$PWD/.venv/bin/python}"; [ -x "$PY" ] || PY=python3

CREW="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$CREW" || exit 1

echo "=== science-collect $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

python3 science/outcomes.py ship --days 30
ship_rc=$?
if [ "$ship_rc" -ne 0 ]; then
  echo "science-collect: outcomes.py ship exited $ship_rc; collecting anyway so the"
  echo "                 telemetry half is not lost with the outcome half."
fi

python3 science/outcomes.py attention --days 7
att_rc=$?
if [ "$att_rc" -ne 0 ]; then
  echo "science-collect: outcomes.py attention exited $att_rc"
fi

# crew#368: the DORA keys as a source, not a printout. --days 14 so held_7d (merged 7+ days
# ago and never reverted) has a window to count in; a failure is a run line, not a stale source.
python3 science/dora.py --days 14 --jsonl science/dora.jsonl
dora_rc=$?
if [ "$dora_rc" -ne 0 ]; then
  echo "science-collect: dora.py exited $dora_rc"
fi
# crew#366: every merged PR's Options-considered block becomes a decision row on the log
# decision-log.py writes; a failure is a run line, not a stale source.
python3 science/decisions_intake.py pull || echo "science-collect: decisions_intake.py exited $?"

python3 science/outcomes.py revenue
rev_rc=$?
if [ "$rev_rc" -ne 0 ]; then
  echo "science-collect: outcomes.py revenue exited $rev_rc (NOT RUN is recorded, not hidden)"
fi

# crew#90: the check runs main's collect.py and main's contract (sources.json, schemas/)
# from a detached worktree at origin/main, against the ledgers in this checkout. On
# 2026-08-27 the live checkout sat at 838ec8f with an uncommitted registry while main
# carried the schema the ledger needed, and every scheduled run exited 1 for a contract
# main had already fixed. The worktree holds no ledgers: SCIENCE_DATA and SCIENCE_WAREHOUSE
# keep every read and write here, and the snapshot commit (crew#479) still sees them.
WT="${CREW_SCIENCE_WORKTREE:-$HOME/.claude/state/crew-science-worktree}"
COLLECT="science/collect.py"
if git fetch -q origin main 2>/dev/null; then
  if [ ! -e "$WT/.git" ]; then
    git worktree prune
    git worktree add --detach -q "$WT" origin/main 2>/dev/null
  fi
  if git -C "$WT" checkout -q --detach origin/main 2>/dev/null; then
    COLLECT="$WT/science/collect.py"
    echo "science-collect: collect.py from origin/main $(git -C "$WT" rev-parse --short HEAD) (checkout at $(git rev-parse --short HEAD))"
  else
    echo "science-collect: worktree at $WT could not move to origin/main; running this checkout's copy"
  fi
else
  echo "science-collect: origin unreachable; running this checkout's copy of collect.py"
fi
export SCIENCE_DATA="$CREW/science" SCIENCE_WAREHOUSE="$CREW/science/warehouse.db"
python3 "$COLLECT" --check
collect_rc=$?
unset SCIENCE_DATA SCIENCE_WAREHOUSE

# crew#319: the transcript store, every byte read once by offset. Its own exit code never
# gates this job: a transcript that cannot be read is a run row, not a stale source.
python3 science/transcripts.py
transcripts_rc=$?

for step in pull train score predict; do
  "$PY" science/foresight.py "$step" || echo "science-collect: foresight $step exited $?"
done

"$PY" science/showcase.py
showcase_rc=$?


echo "science-collect: ship=$ship_rc attention=$att_rc revenue=$rev_rc collect=$collect_rc transcripts=$transcripts_rc showcase=$showcase_rc"
exit "$collect_rc"
